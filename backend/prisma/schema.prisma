// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  COACH
  CLIENT
}

model User {
  id            String       @id @default(uuid())
  googleId      String?      @unique
  name          String
  email         String       @unique
  password      String?
  picture       String?
  role          Role         @default(CLIENT)
  weeklyGoal    Int          @default(3)
  currentStreak Int          @default(0)

  dailyCalories Int          @default(2500)
  dailyProtein  Int          @default(150)
  dailyCarbs    Int          @default(300)
  dailyFat      Int          @default(80)

  // Subscrição e Período de Testes (PT SaaS)
  trialEndsAt          DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?      @default("trialing")

  createdAt     DateTime     @default(now())

  workouts         Workout[]
  assignedWorkouts Workout[]     @relation("AssignedWorkouts")
  logs             WorkoutLog[]
  bodyMetrics      BodyMetric[]
  meals            MealLog[]
  clients          CoachClient[] @relation("CoachClients")
  coaches          CoachClient[] @relation("ClientCoaches")
  sentInvites      CoachInvite[] @relation("CoachInvites")
}

model CoachClient {
  id        String   @id @default(uuid())
  coachId   String
  clientId  String
  createdAt DateTime @default(now())

  coach  User @relation("CoachClients", fields: [coachId], references: [id], onDelete: Cascade)
  client User @relation("ClientCoaches", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([coachId, clientId])
  @@index([coachId])
  @@index([clientId])
}

// NOVO MODELO: O Treino (ex: "Dia de Peito", "Leg Day")
model Workout {
  id          String     @id @default(uuid())
  name        String     
  description String?    
  
  // Relação: Quem é o dono deste treino? 
  // O onDelete: Cascade significa que se apagares a tua conta, os teus treinos são apagados também
  userId      String     
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // PT que atribuiu este treino (opcional)
  assignedById String?
  assignedBy   User?     @relation("AssignedWorkouts", fields: [assignedById], references: [id], onDelete: SetNull)
  isTemplate   Boolean   @default(false)
  category     String?   // Categoria (ex: Força, Hipertrofia, Mobilidade, Iniciante)
  
  // Relação: Um treino tem uma lista de exercícios
  exercises   Exercise[] 
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  logs        WorkoutLog[]
}

// NOVO MODELO: O Exercício dentro do treino (ex: "Supino Plano")
model Exercise {
  id          String   @id @default(uuid())
  name        String   
  sets        Int      @default(3) // Séries padrão: 3
  reps        Int      @default(10) // Repetições padrão: 10
  weight      Float?   // Peso em kg (opcional)
  restSeconds Int?     @default(90) // Descanso sugerido em segundos
  notes       String?  // Instruções de postura/execução do PT
  
  // Relação: A que treino pertence este exercício?
  workoutId   String   
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())

  setLogs     WorkoutSetLog[]
}

model WorkoutLog {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now()) // Regista automaticamente o dia e hora
  userId          String
  workoutId       String
  durationMinutes Int      @default(0)
  notes           String?  // Feedback pós-treino do aluno ao PT
  rating          Int?     // Nível de esforço/satisfação de 1 a 5

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout         Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  setLogs         WorkoutSetLog[]
}

model WorkoutSetLog {
  id           String     @id @default(uuid())
  workoutLogId String
  exerciseId   String?
  exerciseName String
  setNumber    Int
  reps         Int
  weight       Float?     // Carga utilizada em kg
  completed    Boolean    @default(true)
  rpe          Float?     // Escala de esforço subjetivo (ex: 8.5)
  setType      String?    @default("NORMAL") // NORMAL, WARMUP, DROPSET, FAILURE

  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exercise     Exercise?  @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  createdAt    DateTime   @default(now())

  @@index([workoutLogId])
  @@index([exerciseName])
}

model BodyMetric {
  id        String   @id @default(uuid())
  userId    String
  weight    Float
  chest     Float?   // Peito em cm
  waist     Float?   // Cintura em cm
  arms      Float?   // Braço em cm
  thighs    Float?   // Coxa em cm
  bodyFat   Float?   // % Gordura corporal estimada
  photoUrl  String?  // Fotografia de avaliação corporal
  notes     String?  // Observações da avaliação física
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MealLog {
  id        String   @id @default(uuid())
  userId    String
  name      String
  calories  Int
  protein   Int
  carbs     Int
  fat       Int
  imageUri  String?  // Para quando metermos a câmara a funcionar!
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model CoachInvite {
  id          String   @id @default(uuid())
  code        String   @unique
  coachId     String
  coach       User     @relation("CoachInvites", fields: [coachId], references: [id], onDelete: Cascade)
  clientEmail String?
  status      String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([coachId])
  @@index([code])
}