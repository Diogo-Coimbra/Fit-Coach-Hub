{
  "expo": {
    "name": "Fit Coach Hub",
    "slug": "fit-coach-hub",
    "scheme": ["fitcoachhub", "com.diogocoimbra.fitcoachhub"],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0D10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diogocoimbra.fitcoachhub",
      "infoPlist": {
        "NSCameraUsageDescription": "A aplicação necessita de acesso à câmara para fotografar pratos para cálculo de calorias por IA e fotos de evolução corporal.",
        "NSMicrophoneUsageDescription": "A aplicação necessita de acesso ao microfone para permitir o envio de notas de voz no chat com o treinador.",
        "NSPhotoLibraryUsageDescription": "A aplicação necessita de acesso à galeria de fotos para envio de check-ins semanais e registo de refeições."
      }
    },
    "android": {
      "package": "com.diogocoimbra.fitcoachhub",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-audio",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aceder à galeria para fotos de evolução corporal e refeições.",
          "cameraPermission": "Utilizar a câmara para registo fotográfico de refeições e check-in."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3bbb589a-8df1-4b37-9bd6-1577b87a1c9c"
      }
    }
  }
}
