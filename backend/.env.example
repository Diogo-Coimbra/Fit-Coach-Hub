# ==========================================
# FIT AI TRACKER - CONFIGURAÇÃO DE AMBIENTE
# ==========================================

# Servidor e Base de Dados (Neon PostgreSQL)
PORT=3000
DATABASE_URL="postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/fit_tracker?sslmode=require"

# Autenticação Google OAuth 2.0
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Segurança JWT (Assinatura de Tokens de Sessão)
JWT_SECRET="generate-a-strong-secret-key-for-jwt-signing"

# Inteligência Artificial (Google Gemini 2.5 Flash)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Frontend URL (Para redirecionamento pós-checkout Stripe)
FRONTEND_URL="http://localhost:8081"

# ==========================================
# PAGAMENTOS & SUBSCRIÇÕES (STRIPE)
# ==========================================
# Deixe em branco para usar o modo automático de simulação dev
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_MONTHLY="price_..."

# ==========================================
# ARMAZENAMENTO DE FOTOS EM NUVEM (OPCIONAL)
# ==========================================
# Deixe em branco para guardar na pasta local 'uploads/'.
# Em produção (Render / Railway / Fly.io), configure o Cloudinary para ter URLs permanentes:
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
