# ==========================================
# FIT COACH HUB - CONFIGURAÇÃO DE AMBIENTE
# ==========================================

# Servidor e Base de Dados (Neon PostgreSQL)
PORT=3000
DATABASE_URL="postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/fit_tracker?sslmode=require"

# Autenticação Google OAuth 2.0
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Segurança JWT (Assinatura de Tokens de Sessão)
JWT_SECRET="generate-a-strong-secret-key-for-jwt-signing"

# Inteligência Artificial (Google Gemini 2.5 Flash)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Frontend URL (Para redirecionamento pós-checkout Stripe)
FRONTEND_URL="http://localhost:8081"

# ==========================================
# ENVIO DE EMAILS TRANSACIONAIS (RECUPERAÇÃO DE PASS, BOAS-VINDAS)
# ==========================================
# Opção 1: Resend (Recomendado - 3.000 emails grátis/mês: https://resend.com)
RESEND_API_KEY="re_..."
EMAIL_FROM="Fit Coach Hub <onboarding@resend.dev>" # ou suporte@fitcoachhub.com com domínio próprio

# Opção 2: Gmail SMTP com App Password (Alternativa rápida sem domínio)
# GMAIL_USER="fitcoachhub.app@gmail.com"
# GMAIL_APP_PASS="xxxx xxxx xxxx xxxx"

# ==========================================
# PAGAMENTOS & SUBSCRIÇÕES (STRIPE)
# ==========================================
# Deixe em branco para usar o modo automático de simulação dev
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_MONTHLY="price_..."

# ==========================================
# ARMAZENAMENTO DE FOTOS EM NUVEM (OPCIONAL)
# ==========================================
# Deixe em branco para guardar na pasta local 'uploads/'.
# Em produção (Render / Railway / Fly.io), configure o Cloudinary para ter URLs permanentes:
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

