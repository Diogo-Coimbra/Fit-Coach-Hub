// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  COACH
  CLIENT
}

model User {
  id            String       @id @default(uuid())
  googleId      String?      @unique
  name          String
  email         String       @unique
  password      String?
  picture       String?
  role          Role         @default(CLIENT)
  weeklyGoal    Int          @default(3)
  currentStreak Int          @default(0)

  dailyCalories Int          @default(2500)
  dailyProtein  Int          @default(150)
  dailyCarbs    Int          @default(300)
  dailyFat      Int          @default(80)

  // Subscrição e Período de Testes (PT SaaS)
  trialEndsAt          DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?      @default("trialing")

  // Notificações Push (Expo)
  pushToken            String?

  // Recuperação de Password
  resetToken           String?
  resetTokenExpiry     DateTime?

  // Marca do Treinador (para Relatórios PDF e Apresentação)
  coachBrandName       String?
  coachLogoUrl         String?
  coachPhone           String?
  coachBio             String?

  createdAt     DateTime     @default(now())

  workouts         Workout[]
  assignedWorkouts Workout[]     @relation("AssignedWorkouts")
  logs             WorkoutLog[]
  bodyMetrics      BodyMetric[]
  weeklyCheckIns   WeeklyCheckIn[]
  meals            MealLog[]
  clients          CoachClient[] @relation("CoachClients")
  coaches          CoachClient[] @relation("ClientCoaches")
  sentInvites      CoachInvite[] @relation("CoachInvites")
  sentMessages     ChatMessage[] @relation("SentMessages")
  coachMessages    ChatMessage[] @relation("CoachMessages")
  clientMessages   ChatMessage[] @relation("ClientMessages")
}

model CoachClient {
  id        String   @id @default(uuid())
  coachId   String
  clientId  String
  createdAt DateTime @default(now())

  coach  User @relation("CoachClients", fields: [coachId], references: [id], onDelete: Cascade)
  client User @relation("ClientCoaches", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([coachId, clientId])
  @@index([coachId])
  @@index([clientId])
}

// NOVO MODELO: O Treino (ex: "Dia de Peito", "Leg Day")
model Workout {
  id          String     @id @default(uuid())
  name        String     
  description String?    
  
  // Relação: Quem é o dono deste treino? 
  // O onDelete: Cascade significa que se apagares a tua conta, os teus treinos são apagados também
  userId      String     
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // PT que atribuiu este treino (opcional)
  assignedById String?
  assignedBy   User?     @relation("AssignedWorkouts", fields: [assignedById], references: [id], onDelete: SetNull)
  isTemplate   Boolean   @default(false)
  category     String?   // Categoria (ex: Força, Hipertrofia, Mobilidade, Iniciante)
  routineTag   String?   // "A", "B", "C", "D" (Divisão Semanal)
  programName  String?   // "Mesociclo 1 - Hipertrofia", "Fase de Força"
  
  // Relação: Um treino tem uma lista de exercícios
  exercises   Exercise[] 
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  logs        WorkoutLog[]
}

// NOVO MODELO: O Exercício dentro do treino (ex: "Supino Plano")
model Exercise {
  id          String   @id @default(uuid())
  name        String   
  sets        Int      @default(3) // Séries padrão: 3
  reps        Int      @default(10) // Repetições padrão: 10
  weight      Float?   // Peso em kg (opcional)
  restSeconds Int?     @default(90) // Descanso sugerido em segundos
  notes       String?  // Instruções de postura/execução do PT
  videoUrl    String?  // Link de vídeo/GIF de demonstração da técnica
  audioUrl    String?  // Nota de áudio do PT com instruções de execução
  
  // Especificidades de Cardio
  isCardio        Boolean  @default(false)
  durationMinutes Int?     // Duração sugerida em minutos (ex: 20, 30, 45)
  intensity       String?  // Intensidade sugerida (ex: Moderada, HIIT, Zona 2)

  // Relação: A que treino pertence este exercício?
  workoutId   String   
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())

  setLogs     WorkoutSetLog[]
}

model WorkoutLog {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now()) // Regista automaticamente o dia e hora
  userId          String
  workoutId       String
  durationMinutes Int      @default(0)
  notes           String?  // Feedback pós-treino do aluno ao PT
  rating          Int?     // Nível de esforço/satisfação de 1 a 5
  rpe             Float?   // RPE da sessão de 1 a 10
  painJoints      String?  // Articulações com dor (ex: "Joelho, Lombar")
  painLevel       Int?     // 0 a 10

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout         Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  setLogs         WorkoutSetLog[]
}

model WorkoutSetLog {
  id           String     @id @default(uuid())
  workoutLogId String
  exerciseId   String?
  exerciseName String
  setNumber    Int
  reps         Int
  weight       Float?     // Carga utilizada em kg
  completed    Boolean    @default(true)
  rpe          Float?     // Escala de esforço subjetivo (ex: 8.5)
  setType      String?    @default("NORMAL") // NORMAL, WARMUP, DROPSET, FAILURE
  
  // Registo de Cardio
  durationMinutes Int?    // Duração real realizada em minutos
  intensity       String? // Intensidade executada

  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exercise     Exercise?  @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  createdAt    DateTime   @default(now())

  @@index([workoutLogId])
  @@index([exerciseName])
}

model BodyMetric {
  id        String   @id @default(uuid())
  userId    String
  weight    Float
  chest     Float?   // Peito em cm
  waist     Float?   // Cintura em cm
  arms      Float?   // Braço em cm
  thighs    Float?   // Coxa em cm
  bodyFat   Float?   // % Gordura corporal estimada
  photoUrl  String?  // Fotografia de avaliação corporal
  notes     String?  // Observações da avaliação física
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MealLog {
  id        String   @id @default(uuid())
  userId    String
  name      String
  calories  Int
  protein   Int
  carbs     Int
  fat       Int
  imageUri  String?  // Para quando metermos a câmara a funcionar!
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model CoachInvite {
  id          String   @id @default(uuid())
  code        String   @unique
  coachId     String
  coach       User     @relation("CoachInvites", fields: [coachId], references: [id], onDelete: Cascade)
  clientEmail String?
  status      String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([coachId])
  @@index([code])
}

model WeeklyCheckIn {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  weight        Float     // Peso em jejum (kg)
  energyLevel   Int       @default(7) // 1 a 10
  dietAdherence Int       @default(8) // 1 a 10
  sleepQuality  Int?      @default(7) // 1 a 10
  painLevel     Int?      @default(0) // 0 a 10 (0 = sem dor)
  painNotes     String?   // Detalhes de dores articulares ou musculares
  notes         String?   // Observações gerais da semana do aluno

  frontPhotoUrl String?   // Foto frontal
  backPhotoUrl  String?   // Foto costas
  sidePhotoUrl  String?   // Foto lateral/perfil

  coachFeedback String?   // Feedback e orientações do treinador
  reviewedAt    DateTime? // Data de revisão pelo treinador

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model ChatMessage {
  id        String   @id @default(uuid())
  coachId   String
  clientId  String
  senderId  String
  text      String?
  mediaUrl  String?  // Foto, Vídeo, Áudio ou Ficheiro
  mediaType String?  @default("TEXT") // 'TEXT' | 'IMAGE' | 'VIDEO' | 'AUDIO' | 'FILE'
  fileName  String?  // Nome original do ficheiro se aplicável
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  coach     User     @relation("CoachMessages", fields: [coachId], references: [id], onDelete: Cascade)
  client    User     @relation("ClientMessages", fields: [clientId], references: [id], onDelete: Cascade)
  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([coachId, clientId, createdAt])
  @@index([clientId])
  @@index([coachId])
}